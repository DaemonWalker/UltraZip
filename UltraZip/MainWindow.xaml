<Window x:Class="UltraZip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UltraZip" Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Background="#F4F6F9" FontFamily="Microsoft YaHei UI"
        WindowStyle="None" StateChanged="Window_StateChanged" KeyDown="Window_KeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25324B"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#687386"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E7EE"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#59687D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF1FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE8F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#275FBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#204FA2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="16,9,12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#275FBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#204FA2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitPrimaryArrowButton" TargetType="Button" BasedOn="{StaticResource SplitPrimaryButton}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#80FFFFFF" BorderThickness="1,0,0,0"
                                CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#275FBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#204FA2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,0,1"
                                CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF1FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE8F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitSecondaryArrowButton" TargetType="Button" BasedOn="{StaticResource SplitSecondaryButton}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF1FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE8F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EDF2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDE3EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A82417"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#59687D"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F6FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EEFC"/>
                    <Setter Property="Foreground" Value="#204F9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CompactEntryTemplate">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="9,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="56" Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7C3;"
                                   Foreground="White" FontSize="19"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UltraZip" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="安全、高效的压缩与解压工具" FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Menu Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextBrush}"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="文件">
                        <MenuItem Header="打开压缩包…" Click="Browse_Click"/>
                        <MenuItem x:Name="NewArchiveMenuItem" Header="新建压缩包…" Click="CreateArchive_Click"/>
                        <Separator/>
                        <MenuItem Header="退出" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem x:Name="SelectAllMenuItem" Header="全选" IsEnabled="False" Click="SelectVisible_Click"/>
                        <MenuItem x:Name="ClearSelectionMenuItem" Header="全部取消" IsEnabled="False" Click="ClearSelection_Click"/>
                        <MenuItem x:Name="InvertSelectionMenuItem" Header="反向选择" IsEnabled="False" Click="InvertSelection_Click"/>
                        <Separator/>
                        <MenuItem x:Name="EditExtractSelectedMenuItem" Header="解压选中到指定目录…"
                                  IsEnabled="False" Click="ExtractSelected_Click"/>
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="启动画面" InputGestureText="F6" Click="StartScreen_Click"/>
                        <MenuItem x:Name="FolderTreeMenuItem" Header="树形目录" InputGestureText="F7"
                                  IsCheckable="True" IsChecked="True" Click="FolderTreeMenuItem_Click"/>
                        <MenuItem x:Name="ArchiveCommentMenuItem" Header="压缩文件注释" InputGestureText="F8"
                                  IsEnabled="False" Click="ArchiveComment_Click"/>
                        <MenuItem x:Name="ImagePreviewMenuItem" Header="图像预览"
                                  IsCheckable="True" Click="ImagePreviewMenuItem_Click"/>
                        <Separator/>
                        <MenuItem x:Name="ToolbarMenuItem" Header="工具栏" IsCheckable="True"
                                  IsChecked="True" Click="ToolbarMenuItem_Click"/>
                        <MenuItem x:Name="StatusBarMenuItem" Header="状态栏" IsCheckable="True"
                                  IsChecked="True" Click="StatusBarMenuItem_Click"/>
                        <MenuItem Header="视图样式">
                            <MenuItem x:Name="DetailsViewMenuItem" Header="明细" IsCheckable="True"
                                      IsChecked="True" Click="DetailsViewMenuItem_Click"/>
                            <MenuItem x:Name="ListStyleMenuItem" Header="列表" IsCheckable="True"
                                      Click="ListStyleMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="列设置…" Click="ColumnSettings_Click"/>
                        <Separator/>
                        <MenuItem x:Name="TopmostMenuItem" Header="窗口置顶" IsCheckable="True"
                                  Click="TopmostMenuItem_Click"/>
                        <Separator/>
                        <MenuItem x:Name="UpFolderMenuItem" Header="上一级" IsEnabled="False" Click="UpFolder_Click"/>
                        <MenuItem x:Name="RefreshMenuItem" Header="刷新" IsEnabled="False" Click="RefreshArchive_Click"/>
                    </MenuItem>
                    <MenuItem Header="工具">
                        <MenuItem x:Name="TestMenuItem" Header="测试压缩包" IsEnabled="False" Click="TestArchive_Click"/>
                        <MenuItem Header="扫描伪装包" Click="ScanPolyglot_Click"/>
                        <MenuItem Header="密码管理器" Click="PasswordManager_Click"/>
                        <Separator/>
                        <MenuItem Header="设置…" Click="Settings_Click"/>
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Header="支持的格式" Click="SupportedFormats_Click"/>
                        <MenuItem Header="关于 UltraZip" Click="About_Click"/>
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="1" Height="24" Margin="8,0" Background="{StaticResource BorderBrush}"/>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="最小化"
                            AutomationProperties.Name="最小化" Click="MinimizeWindow_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE921;" FontSize="14"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化"
                            AutomationProperties.Name="最大化" Click="MaximizeWindow_Click">
                        <TextBlock x:Name="MaximizeIcon" Style="{StaticResource IconText}" Text="&#xE922;" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" ToolTip="关闭"
                            AutomationProperties.Name="关闭" Click="CloseWindow_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="14"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ToolbarPanel" Grid.Row="1" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="20,10">
                <Button Style="{StaticResource PrimaryButton}" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;"
                                   Foreground="White" FontSize="18"/>
                        <TextBlock Text="打开压缩包" Foreground="White" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CreateButton" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="CreateArchive_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="16"/>
                        <TextBlock Text="新建压缩包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="26" Margin="14,0" Background="{StaticResource BorderBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExtractButton" Style="{StaticResource SplitPrimaryButton}"
                            IsEnabled="False" Click="Extract_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"
                                       Foreground="White" FontSize="17"/>
                            <TextBlock Text="解压全部" Foreground="White" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExtractMenuButton" Grid.Column="1"
                            Style="{StaticResource SplitPrimaryArrowButton}" IsEnabled="False"
                            Click="Dropdown_Click" ToolTip="更多解压操作">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="解压全部到指定目录…" Click="Extract_Click"/>
                                <MenuItem x:Name="ExtractSelectedMenuItem" Header="解压选中到指定目录…"
                                          IsEnabled="False" Click="ExtractSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="解压全部到当前目录" Click="ExtractHere_Click"/>
                                <MenuItem Header="解压全部到“压缩包名称”子目录" Click="ExtractNamedFolder_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ExtractDeleteMenuItem" Header="解压并删除压缩文件…"
                                          IsEnabled="False" Click="ExtractDelete_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="▾" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SelectAllButton" Style="{StaticResource SplitSecondaryButton}"
                            IsEnabled="False" Click="SelectVisible_Click" ToolTip="全选当前目录中的条目">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B3;" FontSize="16"/>
                            <TextBlock Text="全选" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectMenuButton" Grid.Column="1"
                            Style="{StaticResource SplitSecondaryArrowButton}" IsEnabled="False"
                            Click="Dropdown_Click" ToolTip="更多选择操作">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="全选" Click="SelectVisible_Click"/>
                                <MenuItem Header="全部取消" Click="ClearSelection_Click"/>
                                <MenuItem Header="反向选择" Click="InvertSelection_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="▾" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <Border Width="1" Height="26" Margin="14,0" Background="{StaticResource BorderBrush}"/>
                <Button Style="{StaticResource ToolbarButton}" Click="ScanPolyglot_Click"
                        ToolTip="扫描文件中的内嵌压缩包">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="15"/>
                        <TextBlock Text="扫描伪装包" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0" Click="PasswordManager_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="15"/>
                        <TextBlock Text="密码管理器" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="7" Background="#EAF1FC"
                            VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7C3;"
                                   Foreground="{StaticResource AccentBrush}" FontSize="19"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="InfoPath" Text="尚未打开压缩包"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="InfoDetail" Text="打开或拖入文件后即可浏览内容"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#F0F3F7" CornerRadius="5"
                            Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="InfoFormat" Text="等待打开" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UpFolderButton" Style="{StaticResource ToolbarButton}"
                                    MinHeight="32" Padding="8,4" IsEnabled="False" Click="UpFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;" FontSize="14"/>
                                    <TextBlock Text="上一级" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Text="归档目录" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;"
                                           FontSize="14" Margin="0,0,7,0"/>
                                <TextBox x:Name="EntryFilterBox" Width="220" Height="32" Padding="9,4"
                                         ToolTip="按名称或路径筛选当前目录"
                                         TextChanged="EntryFilter_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FolderTreeColumn" Width="220" MinWidth="150"/>
                                <ColumnDefinition x:Name="FolderTreeSplitterColumn" Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FolderTreePanel" Grid.Column="0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="文件夹" Margin="14,12,10,8" FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TreeView Grid.Row="1" x:Name="FolderTree" BorderThickness="0"
                                              Padding="6,0,6,8"
                                              SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                                </Grid>
                            </Border>
                            <GridSplitter x:Name="FolderTreeSplitter" Grid.Column="1" Width="5"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" DragCompleted="FolderTreeSplitter_DragCompleted"/>
                            <ListView Grid.Column="2" x:Name="EntryList" BorderThickness="0"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      SelectionMode="Single" MouseDoubleClick="EntryList_MouseDoubleClick"
                                      SelectionChanged="EntryList_SelectionChanged">
                                <ListView.View>
                                    <GridView x:Name="EntryGridView">
                                        <GridViewColumn Width="38">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="NameColumn" Header="名称"
                                                        DisplayMemberBinding="{Binding Name}" Width="270"/>
                                        <GridViewColumn x:Name="SizeColumn" Header="大小"
                                                        DisplayMemberBinding="{Binding DisplaySize}" Width="95"/>
                                        <GridViewColumn x:Name="PackedSizeColumn" Header="压缩后"
                                                        DisplayMemberBinding="{Binding DisplayPackedSize}" Width="95"/>
                                        <GridViewColumn x:Name="ModifiedColumn" Header="修改时间"
                                                        DisplayMemberBinding="{Binding DisplayModified}" Width="145"/>
                                        <GridViewColumn x:Name="CrcColumn" Header="CRC"
                                                        DisplayMemberBinding="{Binding Crc}" Width="85"/>
                                        <GridViewColumn x:Name="MethodColumn" Header="方法"
                                                        DisplayMemberBinding="{Binding Method}" Width="140"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" Visibility="Collapsed"
                                          DragCompleted="PreviewSplitter_DragCompleted"/>
                            <Border x:Name="PreviewPanel" Grid.Column="4" Visibility="Collapsed"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0"
                                    Background="#FBFCFD">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="12,6">
                                        <TextBlock Text="图像预览" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolbarButton}"
                                                Content="×" MinHeight="28" Padding="8,1" FontSize="18"
                                                ToolTip="关闭图像预览" Click="PreviewClose_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="10">
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                                        <StackPanel x:Name="PreviewMessagePanel" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xEB9F;"
                                                       FontSize="38" Foreground="#A3ADBA"/>
                                            <TextBlock x:Name="PreviewStatusText" Text="选择图片文件即可预览"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Margin="12,4,12,12">
                                        <ProgressBar x:Name="PreviewProgress" Height="3" IsIndeterminate="True"
                                                     Visibility="Collapsed" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="PreviewNameText" TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PreviewDetailText" Margin="0,4,0,0" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="支持 PNG、JPEG、BMP、GIF、ICO、TIFF；单条最大 30 MB"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="#FBFCFD"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,8,8" Padding="12,7">
                            <TextBlock Text="双击文件可使用默认程序打开；勾选条目后可仅解压选中内容"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="WelcomePanel" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="20" Background="#EAF1FC"
                                    HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;"
                                           FontSize="38" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="打开压缩包，开始浏览" Margin="0,22,0,0"
                                       HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="支持 7z、ZIP、RAR 等常见格式，也支持加密包与分卷压缩包"
                                       Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Click="Browse_Click" Padding="22,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;"
                                                   Foreground="White"/>
                                        <TextBlock Text="选择压缩包" Foreground="White" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                        Padding="22,10" Click="CreateArchive_Click">
                                    <TextBlock Text="新建压缩包" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <Border Margin="0,26,0,0" Padding="18,8" CornerRadius="5" Background="#F5F7FA">
                                <TextBlock Text="也可以将压缩包直接拖放到窗口中"
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="DestinationPanel" Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="16"/>
                        <TextBlock Text="解压到" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="DestBox" Height="34" Padding="10,5"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Content="浏览…" MinHeight="34" Padding="14,5" Margin="8,0,0,0"
                            Click="BrowseDest_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="StatusBarPanel" Grid.Row="3" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid MinHeight="38" Margin="16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="ArchiveStatsText" Text="尚未打开压缩包"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <ProgressBar Grid.Column="1" x:Name="Progress" Height="5" Minimum="0" Maximum="100"
                             VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                             Background="#E8EDF3"/>
                <TextBlock Grid.Column="2" x:Name="ProgressText" Margin="7,0,0,0"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="3" x:Name="StatusText" Text="就绪" Margin="12,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <Button Grid.Column="4" x:Name="CancelButton" Style="{StaticResource ToolbarButton}"
                        Content="取消任务" MinHeight="28" Padding="9,3" FontSize="11"
                        IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
