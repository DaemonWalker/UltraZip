<Window x:Class="UltraZip.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 集成设置" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="注册后，文件和文件夹右键菜单将提供“添加到压缩文件…”，压缩包级联菜单提供打开、解压和测试，并加入“打开方式”和默认应用候选列表。不会修改现有默认应用。"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,12"
                   Text="Windows 11 会在“显示更多选项”中显示这些命令。为所有用户注册需要 UAC 管理员授权。"/>
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="注册（当前用户）" Width="135" Margin="0,0,8,6" Click="Register_Click"/>
            <Button Content="为所有用户注册…" Width="140" Margin="0,0,8,6" Click="RegisterAllUsers_Click"/>
            <Button Content="移除右键菜单与关联" Width="155" Margin="0,0,0,6" Click="Unregister_Click"/>
        </WrapPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="更改会立即通知资源管理器。"/>
            <Button Grid.Column="1" Content="关闭" Width="80" Margin="12,0,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
