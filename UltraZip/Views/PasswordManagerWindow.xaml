<Window x:Class="UltraZip.Views.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管理器" Width="560" Height="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="DarkRed" TextWrapping="Wrap"
                   Text="密码以明文保存在 %APPDATA%\UltraZip\passwords.json，请注意保护该文件。"/>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Single"
                  ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="备注" Binding="{Binding Label}" Width="*"/>
                <DataGridTextColumn Header="密码" Binding="{Binding Password}" Width="*"/>
                <DataGridTextColumn Header="命中次数" Binding="{Binding HitCount}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="最近使用" Binding="{Binding LastUsed, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="添加" Width="80" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="删除" Width="80" Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="关闭" Width="80" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
