<Window x:Class="UltraZip.Views.ColumnSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="列设置" Width="430" Height="420" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="勾选要显示的列，使用按钮调整顺序；列宽可直接在归档列表中拖动。"
                   TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,12"/>
        <ListBox x:Name="ColumnList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="上移" Width="76" Margin="0,0,8,0" Click="MoveUp_Click"/>
            <Button Content="下移" Width="76" Margin="0,0,8,0" Click="MoveDown_Click"/>
            <Button Content="恢复默认" Width="90" Click="Reset_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="86" IsDefault="True" Margin="0,0,8,0" Click="OK_Click"/>
            <Button Content="取消" Width="86" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
