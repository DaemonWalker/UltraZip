<Window x:Class="UltraZip.Views.CreateArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltraZip.Views"
        Title="新建压缩包" Width="720" Height="650" MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterOwner" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="InputArea" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="源文件和文件夹（可拖入）" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="SourcesList" Grid.Row="0" SelectionMode="Single"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加文件…" Width="85" Margin="0,0,6,0" Click="AddFiles_Click"/>
                        <Button Content="添加文件夹…" Width="95" Margin="0,0,6,0" Click="AddFolder_Click"/>
                        <Button Content="移除" Width="65" Margin="0,0,6,0" Click="RemoveSource_Click"/>
                        <Button Content="上移" Width="65" Margin="0,0,6,0" Click="MoveUp_Click"/>
                        <Button Content="下移" Width="65" Click="MoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="压缩选项" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="格式：" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FormatCombo" Margin="0,0,12,8"
                              DisplayMemberPath="Name" SelectionChanged="FormatCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="压缩级别：" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" x:Name="LevelCombo" SelectedIndex="3" Margin="0,0,0,8">
                        <ComboBoxItem Content="存储（0）" Tag="0"/>
                        <ComboBoxItem Content="最快（1）" Tag="1"/>
                        <ComboBoxItem Content="快（3）" Tag="3"/>
                        <ComboBoxItem Content="标准（5）" Tag="5"/>
                        <ComboBoxItem Content="最大（7）" Tag="7"/>
                        <ComboBoxItem Content="极限（9）" Tag="9"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="密码：" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <local:ImePasswordBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PasswordBox"
                                          Margin="0,0,0,8" PasswordChanged="PasswordBox_PasswordChanged"/>

                    <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="EncryptHeadersCheck"
                              Content="加密文件名（仅 7Z，忘记密码将无法恢复）" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="分卷大小：" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="VolumeCombo" IsEditable="True"
                              SelectedIndex="0" Margin="0,0,12,4">
                        <ComboBoxItem Content="不分卷"/>
                        <ComboBoxItem Content="100m"/>
                        <ComboBoxItem Content="700m"/>
                        <ComboBoxItem Content="4480m"/>
                        <ComboBoxItem Content="1g"/>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                               Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="仅 7Z/ZIP；ZIP 分卷采用 .zip.001 命名"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="输出路径：" VerticalAlignment="Center" Margin="0,4,0,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="OutputBox"
                             VerticalAlignment="Center" Margin="0,4,8,8"/>
                    <Button Grid.Row="4" Grid.Column="3" Content="浏览…" Width="80"
                            HorizontalAlignment="Right" Margin="0,4,0,8" Click="BrowseOutput_Click"/>

                    <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="VerifyCheck"
                              Content="创建后测试压缩包完整性（推荐）" IsChecked="True"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="Progress" Height="18" Minimum="0" Maximum="100"/>
            <TextBlock Grid.Column="1" x:Name="ProgressText" Width="48" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="请添加要压缩的文件或文件夹。"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="85" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="CreateButton" Content="开始压缩" Width="100" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
