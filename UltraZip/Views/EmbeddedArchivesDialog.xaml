<Window x:Class="UltraZip.Views.EmbeddedArchivesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描到的内嵌压缩包" Width="520" Height="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="在该文件中扫描到以下压缩包特征。选择一项后点击“解压所选”。"/>

        <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="List_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="格式" DisplayMemberBinding="{Binding Format}" Width="80"/>
                    <GridViewColumn Header="偏移" DisplayMemberBinding="{Binding OffsetHex}" Width="150"/>
                    <GridViewColumn Header="备注" DisplayMemberBinding="{Binding Note}" Width="220"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="解压所选" Width="90" Margin="0,0,8,0" Click="Extract_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
