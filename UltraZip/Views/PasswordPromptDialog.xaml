<Window x:Class="UltraZip.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltraZip.Views"
        Title="需要密码" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="该压缩包已加密，密码库中的密码均未命中。请输入密码，或从密码库中选择。"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="密码：" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <local:ImePasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="从库中选择：" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="VaultCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                  DisplayMemberPath="Label" SelectionChanged="VaultCombo_SelectionChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="备注：" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="LabelBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

        <CheckBox x:Name="SaveCheck" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12"
                  Content="解压成功后保存到密码库（明文保存）" IsChecked="True"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
